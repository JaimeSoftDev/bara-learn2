APP_NAME="ADNTrate"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Use MySQL by default (see docker-compose.yml at the repo root).
# For a zero-config local run you can switch to `sqlite` instead and
# leave DB_DATABASE unset (a database/database.sqlite file will be used).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=adntrate
DB_USERNAME=adntrate
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Set to your apex domain in production (e.g. .adntrate.com) so the
# session cookie is shared between the API and SPA subdomains.
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@adntrate.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- SPA / Sanctum ---
# Comma separated list of hosts (no protocol) allowed to receive stateful
# (cookie based) API authentication. Add your production SPA domain here.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Comma separated list of full origins (with protocol) allowed via CORS.
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# Used to build links back to the SPA (e.g. Stripe checkout redirects).
FRONTEND_URL=http://localhost:5173

# --- Stripe ---
STRIPE_KEY=pk_test_replace_me
STRIPE_SECRET=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=eur
